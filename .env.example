# Local development. Copy to .env.local.
DATABASE_URL=postgres://homedocs:homedocs@localhost:54330/homedocs
# At least 32 characters: `openssl rand -base64 48`. Rotating it signs everyone out.
SESSION_SECRET=
# At least 32 characters, and NOT the same as SESSION_SECRET. Encrypts stored
# secrets (Wi-Fi, alarm codes) and integration tokens. Losing or changing it makes
# those unreadable — back it up with the database. `openssl rand -base64 48`
INTEGRATIONS_KEY=
# The external origin in production; defaults to http://localhost:3000 in development.
PUBLIC_BASE_URL=
# Where photos and files live. Defaults to ./data in development.
DATA_DIR=
# How many reverse proxies sit in front of the app (default 1). The client address
# is read that many entries from the right of X-Forwarded-For, which a client
# cannot forge. Set CLIENT_IP_HEADER=cf-connecting-ip behind Cloudflare instead.
TRUSTED_PROXY_HOPS=
CLIENT_IP_HEADER=
# Single sign-on (OpenID Connect, e.g. Pocket ID). Off unless all three are set;
# two of three fails the boot. Register <PUBLIC_BASE_URL>/login/oidc/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=
OIDC_ONLY=
OIDC_TRUST_EMAIL=
# Role for a sign-on that matches no account: viewer (default) or member.
OIDC_DEFAULT_ROLE=
